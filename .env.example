# Copy to .env.local and fill in. Every variable is validated at boot by lib/env.ts;
# a missing one fails `pnpm build`.

# Public origin of the app, used in emailed links.
APP_URL=http://localhost:3000

# Supabase project (local stack: `supabase start` prints these).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Direct Postgres connection used by Drizzle. Queries run inside `withRls`, which drops to the
# `authenticated` role so RLS applies. Local stack default shown.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Email. `console` prints invitation emails to the server log instead of sending them.
EMAIL_DELIVERY=console
EMAIL_FROM="Trestle <no-reply@example.com>"
RESEND_API_KEY=

# Only needed for `pnpm test:rls`. `pnpm db:test:start` prints a value for this.
TEST_DATABASE_URL=
